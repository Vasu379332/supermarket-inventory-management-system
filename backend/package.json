{
  "name": "inventory-backend",
  "version": "1.0.0",
  "description": "Supermarket Inventory Express Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:migrate": "npx.cmd prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx.cmd prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "prisma": "^5.11.0"
  }
}
